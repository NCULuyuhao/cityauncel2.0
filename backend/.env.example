PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=cityauncel_game_system
DB_CONNECTION_LIMIT=10

# 請改成至少 32 字以上的隨機字串，正式環境不可使用預設值。
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# 正式環境請明確填入前端網址；多個網址用逗號分隔。
# Example: http://localhost:5173,https://your-domain.com
CORS_ORIGIN=http://localhost:5173

# Increase only when you truly need larger JSON requests.
JSON_BODY_LIMIT=12mb
CLUE_SNAPSHOT_MAX_BYTES=8388608
AI_ARGUMENT_MAX_IMAGE_BYTES=4194304

# Rate limit settings
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=60
GENERAL_RATE_LIMIT_MAX=600

# Azure OpenAI / Microsoft Foundry settings
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=your_default_deployment_name
AZURE_OPENAI_AI_HELPER_DEPLOYMENT=your_ai_helper_deployment_name
AZURE_OPENAI_API_VERSION=preview
AZURE_OPENAI_RESPONSES_URL=
AI_HELPER_MAX_OUTPUT_TOKENS=2600

# Optional fallback: standard OpenAI settings. Used only when AZURE_OPENAI_* is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_HELPER_MODEL=gpt-5-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1/responses
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_OUTPUT_TOKENS=5000
